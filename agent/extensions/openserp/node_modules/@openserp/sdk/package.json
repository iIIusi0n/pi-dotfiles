{
  "name": "@openserp/sdk",
  "version": "0.2.6",
  "description": "TypeScript/JavaScript SDK for the OpenSERP self-hosted server and OpenSERP Cloud.",
  "type": "module",
  "license": "MIT",
  "author": "OpenSERP",
  "homepage": "https://openserp.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openserpapi/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/openserpapi/sdk-js/issues"
  },
  "keywords": [
    "openserp",
    "serp",
    "serp-api",
    "search",
    "search-api",
    "google-search",
    "google-search-api",
    "google",
    "bing",
    "yandex",
    "baidu",
    "duckduckgo",
    "ecosia",
    "scraper",
    "scraping",
    "web-scraping",
    "serpapi",
    "serpapi-alternative",
    "seo",
    "rank-tracking",
    "rank-tracker",
    "keyword-research",
    "ai",
    "ai-grounding",
    "rag",
    "llm",
    "llm-tools",
    "agent",
    "agent-tools",
    "tool-use",
    "openai",
    "anthropic",
    "mcp",
    "typescript",
    "nodejs",
    "edge-runtime"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./generated/oss": {
      "types": "./dist/generated/oss.d.ts",
      "import": "./dist/generated/oss.js",
      "require": "./dist/generated/oss.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "generate:types": "openapi-typescript ../../openserp/docs/openapi.yaml -o src/generated/oss.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "msw": "^2.8.7",
    "openapi-typescript": "^7.8.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
